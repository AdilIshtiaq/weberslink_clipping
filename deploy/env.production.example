# Copy to .env in the project root on the server and fill in the blanks.
#   cp deploy/env.production.example .env
# Generate each secret with:  openssl rand -hex 32

# --- Addresses -------------------------------------------------------------
APP_DOMAIN=clip.weberslink.org
API_DOMAIN=clip-api.weberslink.org
NEXT_PUBLIC_APP_URL=https://clip.weberslink.org
BETTER_AUTH_URL=https://clip.weberslink.org
NEXT_PUBLIC_API_URL=https://clip-api.weberslink.org
# Browser uploads go directly to the API, so it must allow the app's origin.
CORS_ORIGINS=https://clip.weberslink.org

# --- Secrets (generate your own) ------------------------------------------
BETTER_AUTH_SECRET=
BACKEND_AUTH_SECRET=
APP_SETTINGS_ENCRYPTION_KEY=
ALLOW_UNSIGNED_BACKEND_AUTH=false

# --- Plans -----------------------------------------------------------------
# false = plan limits and the free early bird allowance are active.
SELF_HOST=false
EARLY_BIRD_ENABLED=true
EARLY_BIRD_MINUTE_LIMIT=300

# --- AI and transcription (required) ---------------------------------------
ASSEMBLY_AI_API_KEY=
LLM=google-gla:gemini-3-flash-preview
GOOGLE_API_KEY=

# --- Email (required to verify accounts and send notices) -------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL="WeberslinkClip <no-reply@weberslink.org>"

# --- Stripe (only needed to sell Starter and Studio) ----------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_SCALE_PRICE_ID=
